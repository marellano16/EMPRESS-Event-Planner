# Copy this file to .env (which is git-ignored) and fill in your real key.
# The key lives on the backend only; the frontend never sees it.
# Java does NOT read this file automatically. Set these in the terminal you
# start the backend from (see README, "Setup").
GEMINI_API_KEY=your-key-here

# Optional: model name. Names change over time; check Google AI Studio.
GEMINI_MODEL=gemini-2.5-flash

# Where the Streamlit frontend finds the Java backend
BACKEND_URL=http://localhost:8080
